{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit(runs/**)",
      "Edit(siblings/*/runs/**)",
      "Bash({{EMAIL_CLI}} {{INBOX_PRIMARY}} triage *)",
      "Bash({{EMAIL_CLI}} {{INBOX_BOOKINGS}} triage *)",
      "Bash({{EMAIL_CLI}} {{INBOX_RENTALS}} triage *)",
      "Bash({{EMAIL_CLI}} {{INBOX_PRIMARY}} sheets-get *)",
      "Bash({{EMAIL_CLI}} {{INBOX_PRIMARY}} calendar agenda)",
      "Bash({{PMS_LOOKUP_TOOL}} *)",
      "Bash({{PRE_ARRIVAL_TOOL}} --format json)",
      "Bash({{CRM_TOOL}} summary *)",
      "Bash({{PRICING_TOOL}} --format json)"
    ],
    "deny": [
      "Edit(AUTONOMY.md)",
      "Edit(.claude/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash({{EMAIL_CLI}} send*)",
      "Bash({{EMAIL_CLI}} * send*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/autonomy-guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
