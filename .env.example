# Morning Routine Agent — setup values
#
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` to git.
#
# These are setup values, not secrets. Each name matches a {{PLACEHOLDER}}
# in .claude/skills/morning-routine/SKILL.md. Claude Code does not read
# this file at run time: the setup prompt in the README copies the values
# into the skill file. Do not put passwords or API keys here. Your email
# CLI and PMS tools keep their own credentials.
#
# Leave a value empty if you do not use that check. The routine skips it.

# ============================================================
# Email accounts the routine scans
# ============================================================
# The address or account alias your email CLI expects.

INBOX_PRIMARY="info@yourhotel.com"
INBOX_BOOKINGS="bookings@yourhotel.com"
INBOX_RENTALS=""            # optional third inbox

# ============================================================
# Email provider CLI
# ============================================================
# A command-line wrapper that takes an account as its first
# argument and can read mail, Sheets and Calendar for it.

EMAIL_CLI="gws"

# ============================================================
# PMS (Property Management System)
# ============================================================
# A read-only script that looks up reservations.

PMS_LOOKUP_TOOL="tools/lookup_guest.py"

# ============================================================
# Spreadsheet IDs
# ============================================================

SHEET_ID_INBOX=""        # Email tracking sheet ("Inbox" tab)
SHEET_ID_TASKS=""        # Task list sheet ("Tasks" tab)
SHEET_ID_CONCIERGE=""    # Concierge tracker ("Guests" tab), optional

# ============================================================
# Optional tools the routine calls
# ============================================================

PRE_ARRIVAL_TOOL="tools/pre_arrival_scan.py"
CRM_TOOL="tools/crm_pipeline.py"
PRICING_TOOL="tools/dynamic_pricing.py"
