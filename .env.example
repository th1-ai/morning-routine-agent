# Morning Routine Agent — environment variables
#
# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` to git.

# ============================================================
# Email accounts the agent will scan
# ============================================================
# These are referenced inside .claude/skills/morning-routine/SKILL.md
# via the {{INBOX_*}} placeholders.

INBOX_PRIMARY="info@yourhotel.com"
INBOX_BOOKINGS="bookings@yourhotel.com"
INBOX_RENTALS="rentals@yourhotel.com"

# ============================================================
# Email provider CLI
# ============================================================
# The agent shells out to a command-line wrapper that can
# switch between accounts and read/list messages, plus access
# Sheets and Calendar from the same provider.
# Reference setup uses Google Workspace CLI (`gws`).

EMAIL_CLI="gws"

# ============================================================
# PMS (Property Management System) integration
# ============================================================
# The agent uses these tools to look up reservations and
# verify state. Replace with whatever your PMS exposes.

PMS_LOOKUP_TOOL="tools/lookup_guest.py"
PMS_NOTES_TOOL="tools/cloudbeds_notes.py"
PMS_PROPERTY_ID=""

# ============================================================
# Spreadsheet IDs (Google Sheets)
# ============================================================
# Three operational sheets the agent reads.

SHEET_ID_INBOX=""        # Email Inbox tracking sheet (Inbox + Config tabs)
SHEET_ID_TASKS=""        # Task list sheet
SHEET_ID_CONCIERGE=""    # Concierge / VIP guest tracker

# ============================================================
# Auxiliary tools the morning routine orchestrates
# ============================================================
# Each is a wrapper script the routine invokes. Drop or rename
# any you don't use.

PRE_ARRIVAL_TOOL="tools/pre_arrival_scan.py"
CRM_TOOL="tools/crm_pipeline.py"
PRICING_TOOL="tools/dynamic_pricing.py"

# ============================================================
# Google Cloud project (for Workspace CLI auth)
# ============================================================
GCP_PROJECT_ID=""

# ============================================================
# Operator identity (used in briefing language and sign-offs)
# ============================================================
OPERATOR_NAME=""
HOTEL_NAME=""
